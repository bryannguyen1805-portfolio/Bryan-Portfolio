{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "4.0.0",
  "inheritedContractVersion": "3.0.4",
  "project": "Bryan FinTech Intelligence — Phase 06 Financial Intelligence Layer",
  "timezone": "Asia/Ho_Chi_Minh",
  "definitions": {
    "AuditedFinancialFact": {
      "type": "object",
      "required": [
        "factId",
        "eventId",
        "metricName",
        "extractedExpression",
        "numericValue",
        "unit",
        "originalExtractedEntity",
        "verifiedEntity",
        "entityBindingStatus",
        "factType",
        "verificationStatus",
        "contextQuote",
        "isDuplicate"
      ],
      "properties": {
        "factId": { "type": "string", "pattern": "^FACT-[0-9]{8}-[0-9]{3}$" },
        "eventId": { "type": "string", "pattern": "^EVT-[0-9]{8}-[0-9]{3}$" },
        "metricName": { "type": "string", "minLength": 2 },
        "extractedExpression": { "type": "string", "minLength": 1 },
        "numericValue": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "scale": { "type": ["string", "null"] },
        "originalExtractedEntity": { "type": ["string", "null"] },
        "verifiedEntity": { "type": "string", "minLength": 2 },
        "entityBindingStatus": {
          "type": "string",
          "enum": [
            "ENTITY_VERIFIED_FROM_QUOTE",
            "ENTITY_REBOUND_FROM_QUOTE",
            "ENTITY_AMBIGUOUS",
            "ENTITY_UNVERIFIED"
          ]
        },
        "entityBindingNote": { "type": "string" },
        "reportingPeriod": { "type": ["string", "null"] },
        "polarity": { "type": ["string", "null"], "enum": ["UP", "DOWN", "STABLE", null] },
        "factType": { "type": "string" },
        "verificationStatus": { "type": "string", "enum": ["VERIFIED", "REVIEW_REQUIRED", "UNVERIFIED"] },
        "contextQuote": { "type": "string", "minLength": 10 },
        "isDuplicate": { "type": "boolean" },
        "duplicateOfFactId": { "type": ["string", "null"] }
      }
    },
    "CoreThesis": {
      "type": "object",
      "required": [
        "thesisId",
        "themeGroup",
        "title",
        "centralArgument",
        "whatChanged",
        "whyItMatters",
        "supportingEventIds",
        "supportingFactIds",
        "supportingMarketPulseIds",
        "counterEvidence",
        "causalExplanation",
        "affectedSectors",
        "impactHorizon",
        "confidenceLevel",
        "confidenceReason",
        "watchSignals",
        "invalidationConditions",
        "sourceReferences"
      ],
      "properties": {
        "thesisId": { "type": "string", "pattern": "^THESIS-[0-9]{2}$" },
        "themeGroup": {
          "type": "string",
          "enum": [
            "Monetary Policy & Interest Rates",
            "Banking & Credit",
            "Capital Markets",
            "Corporate & Business Expansion",
            "Consumer Behavior",
            "Digital Economy",
            "Cashless Payment & Payment Infrastructure",
            "International Finance & Global Economy"
          ]
        },
        "title": { "type": "string", "minLength": 15 },
        "centralArgument": { "type": "string", "minLength": 30 },
        "whatChanged": { "type": "string", "minLength": 20 },
        "whyItMatters": { "type": "string", "minLength": 20 },
        "supportingEventIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "supportingFactIds": { "type": "array", "items": { "type": "string" } },
        "supportingMarketPulseIds": { "type": "array", "items": { "type": "string" } },
        "counterEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "causalExplanation": { "type": "string", "minLength": 30 },
        "affectedSectors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "impactHorizon": { "type": "string", "enum": ["SHORT_TERM_0_3M", "MEDIUM_TERM_3_12M", "LONG_TERM_12M_PLUS"] },
        "confidenceLevel": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "confidenceReason": { "type": "string", "minLength": 15 },
        "watchSignals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "invalidationConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sourceReferences": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "MacroToMicroChain": {
      "type": "object",
      "required": [
        "chainId",
        "macroDriver",
        "transmissionMechanism",
        "bankingImpact",
        "enterpriseImpact",
        "consumerImpact",
        "paymentImpact",
        "evidenceReferences",
        "inferenceClassification",
        "confidenceLevel",
        "potentialTimeLag",
        "watchSignals"
      ],
      "properties": {
        "chainId": { "type": "string", "pattern": "^CHAIN-[0-9]{2}$" },
        "macroDriver": { "type": "string", "minLength": 15 },
        "transmissionMechanism": { "type": "string", "minLength": 25 },
        "bankingImpact": { "type": "string", "minLength": 15 },
        "enterpriseImpact": { "type": "string", "minLength": 15 },
        "consumerImpact": { "type": "string", "minLength": 15 },
        "paymentImpact": { "type": "string", "minLength": 15 },
        "evidenceReferences": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "inferenceClassification": {
          "type": "object",
          "required": ["macroDriver", "bankingImpact", "enterpriseImpact", "consumerImpact", "paymentImpact"],
          "properties": {
            "macroDriver": { "type": "string", "enum": ["OBSERVED", "SUPPORTED_INFERENCE", "HYPOTHESIS"] },
            "bankingImpact": { "type": "string", "enum": ["OBSERVED", "SUPPORTED_INFERENCE", "HYPOTHESIS"] },
            "enterpriseImpact": { "type": "string", "enum": ["OBSERVED", "SUPPORTED_INFERENCE", "HYPOTHESIS"] },
            "consumerImpact": { "type": "string", "enum": ["OBSERVED", "SUPPORTED_INFERENCE", "HYPOTHESIS"] },
            "paymentImpact": { "type": "string", "enum": ["OBSERVED", "SUPPORTED_INFERENCE", "HYPOTHESIS"] }
          }
        },
        "confidenceLevel": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "potentialTimeLag": { "type": "string", "minLength": 5 },
        "watchSignals": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "PaymentRadarSignal": {
      "type": "object",
      "required": [
        "radarId",
        "signalTitle",
        "marketSignal",
        "triggerEventIds",
        "supportingFacts",
        "marketDrivers",
        "affectedSegments",
        "paymentImplication",
        "commercialRelevance",
        "payooRelevance",
        "opportunityType",
        "riskFactors",
        "recommendedMonitoring",
        "confidenceLevel",
        "evidenceReferences"
      ],
      "properties": {
        "radarId": { "type": "string", "pattern": "^RADAR-[0-9]{2}$" },
        "signalTitle": { "type": "string", "minLength": 10 },
        "paymentDomain": { "type": "string" },
        "marketSignal": { "type": "string", "minLength": 15 },
        "triggerEventIds": { "type": "array", "items": { "type": "string" } },
        "supportingFacts": { "type": "array", "items": { "type": "string" } },
        "marketDrivers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "merchantImpact": { "type": "string" },
        "consumerImpact": { "type": "string" },
        "affectedSegments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "paymentImplication": { "type": "string", "minLength": 15 },
        "opportunity": { "type": "string" },
        "commercialRelevance": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "NONE"] },
        "payooRelevance": { "type": "string", "minLength": 10 },
        "opportunityType": {
          "type": "string",
          "enum": [
            "VERIFIED_OPPORTUNITY",
            "EMERGING_OPPORTUNITY",
            "POTENTIAL_OPPORTUNITY",
            "NO_DIRECT_OPPORTUNITY"
          ]
        },
        "riskFactors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "recommendedMonitoring": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "confidenceLevel": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "evidenceReferences": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "FinancialDecisionCard": {
      "type": "object",
      "required": [
        "decisionId",
        "headline",
        "decisionCategory",
        "executiveSummary",
        "whatChanged",
        "whyItMatters",
        "supportingThesisIds",
        "supportingChainIds",
        "supportingRadarIds",
        "supportingEventIds",
        "supportingMarketPulseIds",
        "opportunity",
        "risk",
        "recommendedAction",
        "monitoringTriggers",
        "timeHorizon",
        "confidenceLevel",
        "evidenceReferences",
        "limitations"
      ],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^DECISION-[0-9]{2}$" },
        "headline": { "type": "string", "minLength": 15 },
        "decisionCategory": {
          "type": "string",
          "enum": [
            "STRATEGIC_SIGNAL",
            "MARKET_OPPORTUNITY",
            "COMMERCIAL_OPPORTUNITY",
            "FINANCIAL_RISK",
            "EMERGING_TREND",
            "MONITORING_REQUIRED"
          ]
        },
        "executiveSummary": { "type": "string", "minLength": 25 },
        "whatChanged": { "type": "string", "minLength": 15 },
        "whyItMatters": { "type": "string", "minLength": 15 },
        "supportingThesisIds": { "type": "array", "items": { "type": "string" } },
        "supportingChainIds": { "type": "array", "items": { "type": "string" } },
        "supportingRadarIds": { "type": "array", "items": { "type": "string" } },
        "supportingEventIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "supportingMarketPulseIds": { "type": "array", "items": { "type": "string" } },
        "opportunity": { "type": "string", "minLength": 10 },
        "risk": { "type": "string", "minLength": 10 },
        "recommendedAction": {
          "type": "string",
          "enum": [
            "MONITOR",
            "INVESTIGATE",
            "VALIDATE",
            "EXPLORE",
            "NO_ACTION_YET"
          ]
        },
        "monitoringTriggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeHorizon": { "type": "string" },
        "confidenceLevel": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "evidenceReferences": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
